{
  "name": "phone-store-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\"",
    "seed:images": "node scripts/gen-placeholder-images.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db.ts seed",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db.ts backup",
    "admin:user": "node --env-file-if-exists=.env.local scripts/db.ts user"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.18.0",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
