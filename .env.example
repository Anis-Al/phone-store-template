# Data source. local = products.json + .data/orders.json (demos, no admin). db = libSQL database (live stores + admin panel).
DATA_ADAPTER=local
# db adapter: file:.data/store.db on a Node host (default), or libsql://<name>.turso.io with DATABASE_AUTH_TOKEN.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Admin session signing key, at least 32 characters: openssl rand -base64 32. Changing it logs everyone out.
SESSION_SECRET=
# Uploaded product photos (default .data/uploads). Keep it on persistent disk and back it up.
UPLOAD_DIR=
# Calendar days for the admin date filters and the dashboard.
TZ=Africa/Algiers
# local adapter only: where orders are stored (default .data/orders.json).
ORDERS_FILE=
